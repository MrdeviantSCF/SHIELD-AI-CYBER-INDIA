# =============================================================================
# SHIELD Cyber Forensic Investigation — Environment Configuration Template
# =============================================================================
#
# Copy this file to `.env` and replace the placeholder values:
#
#   cp .env.example .env          (macOS / Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# NEVER commit a real `.env` file. `.env*` is already git-ignored.
# Every value below is a placeholder — none of these are working credentials.
# All variables are server-side only; none are prefixed with NEXT_PUBLIC_, so
# none of them are exposed to the browser bundle.
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# REQUIRED FOR FULL FUNCTIONALITY
# -----------------------------------------------------------------------------

# PostgreSQL connection string, read by both the app and prisma/schema.prisma.
#
# If this is unset the app still boots and the public marketing pages render
# from static fallbacks, but everything database-backed is unavailable:
# authentication, the client/admin/investigator portals, case verification,
# documents, evidence and chatbot history.
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/shield?schema=public

# Secret for signing/encrypting auth material. Reserved for MFA and
# password-reset flows; server sessions currently use random opaque tokens that
# are SHA-256 hashed at rest, so this is not yet read at runtime.
# Must be at least 16 characters. Generate a unique value per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=CHANGE_ME_generate_a_random_32_byte_secret

# Name of the session cookie. Rarely needs changing.
SESSION_COOKIE_NAME=shield_session

# Public base URL of this deployment. Used for absolute metadata URLs and for
# the same-origin (CSRF) check on state-changing requests, so it must match the
# origin the browser actually uses in production.
APP_BASE_URL=http://localhost:3000

# Node environment: development | test | production
NODE_ENV=development


# -----------------------------------------------------------------------------
# OBJECT STORAGE (optional)
# -----------------------------------------------------------------------------
# S3-compatible private storage for case documents and evidence files.
# Leave blank to use the local-disk development adapter, which writes to
# `.private-storage/` — outside `public/`, so files are never served statically.
#
# The bucket MUST be private. Downloads are authorized server-side and served
# either by streaming or via short-lived signed URLs.
#
# Works with AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces, Backblaze B2.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Set to "true" for MinIO and other path-style providers.
S3_FORCE_PATH_STYLE=


# -----------------------------------------------------------------------------
# SHIELD ASSISTANT / LLM PROVIDER (optional)
# -----------------------------------------------------------------------------
# LLM_PROVIDER: mock | openai
# "mock" is the default and needs no credentials or network access — the
# assistant stays fully functional using the local knowledge base.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional override for any OpenAI-compatible gateway.
LLM_BASE_URL=


# -----------------------------------------------------------------------------
# NOTIFICATION ADAPTERS (optional)
# -----------------------------------------------------------------------------
# Each channel falls back to a mock adapter that logs to the server console
# when its credentials are absent. In-app notifications always work.
EMAIL_API_KEY=
EMAIL_FROM=
WHATSAPP_API_KEY=
WHATSAPP_FROM_NUMBER=
SMS_API_KEY=
SMS_FROM_NUMBER=


# -----------------------------------------------------------------------------
# CASE ID FORMAT (optional)
# -----------------------------------------------------------------------------
# Controls generated case references, e.g. SCF/2026/CF/001
CASE_ID_PREFIX=SCF
CASE_ID_PAD_LENGTH=3


# -----------------------------------------------------------------------------
# FIRST-TIME DATABASE SETUP
# -----------------------------------------------------------------------------
#   npx prisma generate     # generate the typed Prisma client
#   npm run db:migrate      # apply migrations (prisma migrate deploy)
#   npm run db:seed         # DEVELOPMENT ONLY — inserts clearly-labelled demo data
#
# Do not run `npm run db:seed` against a production database.
# -----------------------------------------------------------------------------
